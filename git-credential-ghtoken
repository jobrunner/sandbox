#!/bin/sh
# Git-Credential-Helper: liefert das Token, nichts wird gespeichert.
# Bevorzugt GH_TOKEN_FILE (vom Host laufend erneuert), sonst GH_TOKEN.
# Antwortet nur für https://github.com, damit das Token nie an einen anderen
# Host geht (fremdes Remote, Submodul, zusätzlich freigegebene Domain).
[ "$1" = get ] || exit 0

protocol="" host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*)     host="${line#host=}" ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

token=""
if [ -n "${GH_TOKEN_FILE:-}" ] && [ -r "$GH_TOKEN_FILE" ]; then
  token="$(cat "$GH_TOKEN_FILE")"
fi
[ -n "$token" ] || token="${GH_TOKEN:-}"
[ -n "$token" ] || exit 0
echo username=x-access-token
echo "password=${token}"
